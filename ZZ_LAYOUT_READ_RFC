FUNCTION ZZ_LAYOUT_READ_RFC .
*"----------------------------------------------------------------------
*"*"Local Interface:
*"  IMPORTING
*"     VALUE(IS_VARKEY) TYPE  LTDXKEY
*"  EXPORTING
*"     VALUE(ES_VARIANT) TYPE  DISVARIANT
*"  TABLES
*"      ET_DBFIELDCAT STRUCTURE  LTDXDATA
*"      ET_DBSORTINFO STRUCTURE  LTDXDATA
*"      ET_DBFILTER STRUCTURE  LTDXDATA
*"      ET_DBLAYOUT STRUCTURE  LTDXDATA
*"  EXCEPTIONS
*"      INVALID_KEY
*"      NOT_AUTHORISED
*"      NOT_FOUND
*"      READ_ERROR
*"----------------------------------------------------------------------

  DATA:
    lv_report TYPE ltdx-report,
    lv_text   TYPE ltdxt-text.

  CLEAR:
    es_variant,
    lv_report,
    lv_text.

  REFRESH:
    et_dbfieldcat,
    et_dbsortinfo,
    et_dbfilter,
    et_dblayout.

  " Validate the minimum required key
  IF is_varkey-report IS INITIAL
     OR is_varkey-variant IS INITIAL.
    RAISE invalid_key.
  ENDIF.

  " Add a project-specific authorisation check here if required

  " Confirm that the requested layout exists
  SELECT SINGLE report
    FROM ltdx
    INTO lv_report
    WHERE relid     = 'LT'
      AND report    = is_varkey-report
      AND handle    = is_varkey-handle
      AND log_group = is_varkey-log_group
      AND username  = is_varkey-username
      AND variant   = is_varkey-variant
      AND type      = is_varkey-type.

  IF sy-subrc <> 0.
    RAISE not_found.
  ENDIF.

  " Read the complete external representation of the layout
  CALL FUNCTION 'LT_DBDATA_READ_FROM_LTDX'
    EXPORTING
      i_tool       = 'LT'
      is_varkey    = is_varkey
    TABLES
      t_dbfieldcat = et_dbfieldcat
      t_dbsortinfo = et_dbsortinfo
      t_dbfilter   = et_dbfilter
      t_dblayout   = et_dblayout
    EXCEPTIONS
      not_found    = 1
      wrong_relid  = 2
      OTHERS       = 3.

  CASE sy-subrc.
    WHEN 0.
      " Layout successfully read

    WHEN 1.
      RAISE not_found.

    WHEN OTHERS.
      RAISE read_error.
  ENDCASE.

  " Build the variant header returned to the target system
  es_variant-report    = is_varkey-report.
  es_variant-handle    = is_varkey-handle.
  es_variant-log_group = is_varkey-log_group.
  es_variant-username  = is_varkey-username.
  es_variant-variant   = is_varkey-variant.

  " Read the layout description
  SELECT SINGLE text
    FROM ltdxt
    INTO lv_text
    WHERE relid     = 'LT'
      AND report    = is_varkey-report
      AND handle    = is_varkey-handle
      AND log_group = is_varkey-log_group
      AND username  = is_varkey-username
      AND variant   = is_varkey-variant
      AND type      = is_varkey-type
      AND langu     = sy-langu.

  IF sy-subrc = 0.
    es_variant-text = lv_text.
  ELSE.
    es_variant-text = is_varkey-variant.
  ENDIF.


ENDFUNCTION.
